# ── Database ─────────────────────────────────────────────────
# The production TUI stores the generated database password only in the
# protected secrets/database_password file. The backend constructs its
# connection URL in-process and never writes it here.

# ── Security ────────────────────────────────────────────────
# SECRET_KEY, IP_HMAC_KEY and ROOT_BOOTSTRAP_TOKEN are stored in protected
# files under secrets/ and are never written to .env by the configurator.

# ── Domain & TLS ────────────────────────────────────────────
DOMAIN=mp-opt.net
# Random UUID generated once by the production configurator and shared by HA nodes.
MP_INSTANCE_ID=
GOVERNANCE_SETUP_ACK_VERSION=2026-07-27
# Signed accountability evidence is mandatory for every installation.
EVIDENCE_MODE=required
EVIDENCE_TOMBSTONE_RETENTION_DAYS=1095
EVENT_PURGE_GRACE_DAYS=90
RETENTION_SCHEDULER_INTERVAL_SECONDS=300
WEBAUTHN_RP_ID=mp-opt.net
WEBAUTHN_RP_NAME=GC Calendar
WEBAUTHN_ORIGIN=https://mp-opt.net
COOKIE_SECURE=true
SESSION_COOKIE_NAME=__Host-mp_session
CSRF_COOKIE_NAME=__Host-mp_csrf

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=["https://mp-opt.net"]

# ── Sessions ────────────────────────────────────────────────
SESSION_TTL_HOURS=8
SESSION_TTL_HOURS_ADMIN=1
SESSION_INACTIVITY_MINUTES=30

# ── Web Push (VAPID) ───────────────────────────────────────
# VAPID_PRIVATE_KEY is stored in secrets/vapid_private_key.
VAPID_CLAIMS_EMAIL=mailto:admin@example.com

# ── Activation email (optional) ─────────────────────────────
# Store the SMTP token in secrets/smtp_token, never in this file.
# Example host: smtp.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_SECURITY=starttls
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Masterplan Access
SMTP_REPLY_TO=
SMTP_TIMEOUT_SECONDS=15
