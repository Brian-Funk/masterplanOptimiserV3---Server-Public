FROM node:26-alpine@sha256:aadf416b2cdce311a8811ba3f0608a61b77dbf997500e2eafe781b51f6a0b019

COPY infra/cloudflare-ha-witness/package.json /opt/wrangler/package.json
COPY infra/cloudflare-ha-witness/package-lock.json /opt/wrangler/package-lock.json

# This signed, immutable release image is used only while commissioning the
# Cloudflare witness. No Node.js or npm installation is required on a VPS.
RUN apk upgrade --no-cache \
    && cd /opt/wrangler \
    && npm ci --omit=dev --no-audit --no-fund \
    && ln -s /opt/wrangler/node_modules/.bin/wrangler /usr/local/bin/wrangler \
    && npm cache clean --force \
    && rm -rf \
        /root/.npm \
        /usr/local/lib/node_modules/corepack \
        /usr/local/lib/node_modules/npm \
        /opt/yarn-v* \
    && rm -f \
        /usr/local/bin/corepack \
        /usr/local/bin/npm \
        /usr/local/bin/npx \
        /usr/local/bin/yarn \
        /usr/local/bin/yarnpkg \
    && test ! -e /usr/local/lib/node_modules/npm \
    && test ! -e /usr/local/bin/npm \
    && wrangler --version

WORKDIR /tmp
ENTRYPOINT ["wrangler"]
