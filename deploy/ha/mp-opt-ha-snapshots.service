[Unit]
Description=MP-OPT_SERVER encrypted HA recovery snapshots
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/masterplan
ExecStart=/opt/masterplan/deploy/ha/automatic_snapshots.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/etc/mp-opt-ha /opt/masterplan
ReadWritePaths=-/home/deploy/.config/mp-opt-server -/home/deploy/.local/state/mp-opt-server -/home/deploy/masterplan-snapshots -/opt/masterplan/runtime
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
