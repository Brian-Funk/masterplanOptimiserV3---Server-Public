[Unit]
Description=MP-OPT_SERVER symmetric HA lease agent
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/masterplan
ExecStart=/usr/bin/python3 /opt/masterplan/deploy/ha/lease_agent.py
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/etc/mp-opt-ha /opt/masterplan
ReadWritePaths=/opt/masterplan/runtime /opt/masterplan/secrets/root_bootstrap_token /home/deploy/.local/state/mp-opt-server
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
